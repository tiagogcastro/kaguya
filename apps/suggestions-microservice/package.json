{
  "name": "suggestion-micro-service",
  "version": "0.1.0",
  "description": "Suggestion micro service to kaguya app",
  "author": "Kaguya org",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r ./register-paths.cjs dist/main.js",
    "db:init": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "^6.19.0",
    "graphql": "^16.11.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@apollo/subgraph": "^2.14.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.0",
    "prisma": "^6.19.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true
  }
}
