{
  "name": "platform-backend",
  "version": "1.0.0",
  "main": "build/shared/infra/http/server.js",
  "repository": "https://github.com/sLinked/platform-backend",
  "author": "Marcos Proença, Tiago Gonçalves",
  "license": "MIT",
  "prisma": {
    "seed": "tsx src/shared/infra/prisma/seeders/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch src/shared/infra/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r ./register-paths.cjs build/shared/infra/http/server.js",
    "db:init": "prisma migrate dev --name init",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:unit": "jest --coverage --detectOpenHandles ./src/modules/**/__tests__/unit/**.spec.ts",
    "test:integration": "cross-env NODE_ENV=test jest --detectOpenHandles ./src/modules/**/__tests__/integration/**.spec.ts",
    "test": "npm run test:integration && npm run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@prisma/client": "^6.19.3",
    "@types/mime-types": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "celebrate": "^15.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "jest": "^30.4.2",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
